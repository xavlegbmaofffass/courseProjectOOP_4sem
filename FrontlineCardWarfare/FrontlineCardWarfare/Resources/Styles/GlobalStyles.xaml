<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================== -->
    <!-- CYBERPUNK MILITARY THEME - GLOBAL STYLES -->
    <!-- ========================================== -->

    <!-- Основные цвета -->
    <Color x:Key="CyberDark">#0A0A12</Color>
    <Color x:Key="CyberPrimary">#00D9FF</Color>
    <Color x:Key="CyberSecondary">#FF00E5</Color>
    <Color x:Key="CyberAccent">#7C3AED</Color>
    <Color x:Key="CyberSuccess">#00FF95</Color>
    <Color x:Key="CyberWarning">#FFD700</Color>
    <Color x:Key="CyberError">#FF3860</Color>
    <Color x:Key="CyberTextPrimary">#FFFFFF</Color>
    <Color x:Key="CyberTextSecondary">#A0A0B0</Color>
    <Color x:Key="CyberPanelBackground">#12121F</Color>
    <Color x:Key="CyberCardBackground">#1A1A2E</Color>

    <!-- Кисти -->
    <SolidColorBrush x:Key="CyberDarkBrush" Color="{StaticResource CyberDark}"/>
    <SolidColorBrush x:Key="CyberPrimaryBrush" Color="{StaticResource CyberPrimary}"/>
    <SolidColorBrush x:Key="CyberSecondaryBrush" Color="{StaticResource CyberSecondary}"/>
    <SolidColorBrush x:Key="CyberAccentBrush" Color="{StaticResource CyberAccent}"/>
    <SolidColorBrush x:Key="CyberSuccessBrush" Color="{StaticResource CyberSuccess}"/>
    <SolidColorBrush x:Key="CyberWarningBrush" Color="{StaticResource CyberWarning}"/>
    <SolidColorBrush x:Key="CyberErrorBrush" Color="{StaticResource CyberError}"/>
    <SolidColorBrush x:Key="CyberTextPrimaryBrush" Color="{StaticResource CyberTextPrimary}"/>
    <SolidColorBrush x:Key="CyberTextSecondaryBrush" Color="{StaticResource CyberTextSecondary}"/>
    <SolidColorBrush x:Key="CyberPanelBackgroundBrush" Color="{StaticResource CyberPanelBackground}"/>
    <SolidColorBrush x:Key="CyberCardBackgroundBrush" Color="{StaticResource CyberCardBackground}"/>

    <!-- Градиенты -->
    <LinearGradientBrush x:Key="CyberPrimaryGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00D9FF" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CyberSecondaryGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF00E5" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CyberSuccessGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FF95" Offset="0"/>
        <GradientStop Color="#00B8FF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CyberDangerGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF3860" Offset="0"/>
        <GradientStop Color="#FF6B35" Offset="1"/>
    </LinearGradientBrush>

    <!-- Эффекты свечения -->
    <DropShadowEffect x:Key="CyberPrimaryGlow" Color="#00D9FF" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
    <DropShadowEffect x:Key="CyberSecondaryGlow" Color="#FF00E5" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
    <DropShadowEffect x:Key="CyberSuccessGlow" Color="#00FF95" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>

    <!-- ========================================== -->
    <!-- GLOBAL ANIMATIONS & PERFORMANCE -->
    <!-- ========================================== -->

    <!-- Оптимизированная анимация появления карточек/панелей -->
    <Storyboard x:Key="GlobalCardAppearAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                         From="0" To="1" 
                         Duration="0:0:0.4">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                         From="0.95" To="1" 
                         Duration="0:0:0.4">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                         From="0.95" To="1" 
                         Duration="0:0:0.4">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- Стиль для оптимизации рендеринга анимированных элементов -->
    <Style x:Key="OptimizedAnimatedElement" TargetType="FrameworkElement">
        <Setter Property="RenderOptions.BitmapScalingMode" Value="Linear"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!-- CYBERPUNK BUTTON STYLES -->
    <!-- ========================================== -->

    <Style x:Key="CyberButtonBase" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CyberPrimaryGradient}"/>
        <Setter Property="Foreground" Value="{StaticResource CyberTextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="24,16"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#00D9FF" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)"
                                                        To="35" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                                        To="0.8" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)"
                                                        To="20" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                                        To="0.5" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Основная кнопка -->
    <Style x:Key="CyberPrimaryButton" TargetType="Button" BasedOn="{StaticResource CyberButtonBase}">
        <Setter Property="Background" Value="{StaticResource CyberPrimaryGradient}"/>
    </Style>

    <!-- Вторичная кнопка -->
    <Style x:Key="CyberSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource CyberPrimaryBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="24,16"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{StaticResource CyberPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#00D9FF" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#00D9FF" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetName="border"
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="0.2" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="Transparent" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetName="border"
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="1" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопка успеха (зелёная) -->
    <Style x:Key="CyberSuccessButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CyberSuccessGradient}"/>
        <Setter Property="Foreground" Value="{StaticResource CyberTextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="24,16"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#00FF95" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопка опасности (красная) -->
    <Style x:Key="CyberDangerButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CyberDangerGradient}"/>
        <Setter Property="Foreground" Value="{StaticResource CyberTextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="24,16"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF3860" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопка назад (серая) -->
    <Style x:Key="CyberBackButton" TargetType="Button">
        <Setter Property="Background" Value="#2D2D44"/>
        <Setter Property="Foreground" Value="{StaticResource CyberTextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="20,14"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#4A4A6A"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!-- INPUT CONTROLS STYLES -->
    <!-- ========================================== -->

    <Style x:Key="CyberTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#1A1A2E"/>
        <Setter Property="Foreground" Value="{StaticResource CyberTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="#4A4A6A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="CaretBrush" Value="{StaticResource CyberPrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource CyberPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="GotFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border"
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="#00D9FF" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="LostFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border"
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="#4A4A6A" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CyberPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="#1A1A2E"/>
        <Setter Property="Foreground" Value="{StaticResource CyberTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="#4A4A6A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="CaretBrush" Value="{StaticResource CyberPrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource CyberPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="GotFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border"
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="#00D9FF" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="LostFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border"
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="#4A4A6A" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CyberComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="#1A1A2E"/>
        <Setter Property="Foreground" Value="{StaticResource CyberTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="#4A4A6A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Кнопка-переключатель для открытия списка -->
                        <ToggleButton x:Name="toggleButton"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"
                                      Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="templateBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="10">
                                        <Path x:Name="arrow"
                                              Data="M 0 0 L 6 6 L 12 0 Z"
                                              Fill="{StaticResource CyberPrimaryBrush}"
                                              HorizontalAlignment="Right"
                                              Margin="0,0,16,0"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="templateBorder" Property="BorderBrush" Value="{StaticResource CyberPrimaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="templateBorder" Property="BorderBrush" Value="{StaticResource CyberPrimaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Отображение выбранного элемента -->
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding ItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          VerticalAlignment="Center"
                                          Margin="16,0,36,0"
                                          IsHitTestVisible="False"/>

                        <!-- Выпадающий список -->
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               PopupAnimation="Slide">
                            <Border Background="#2D2D44"
                                    BorderBrush="{StaticResource CyberPrimaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    Margin="0,2,0,0">
                                <ScrollViewer Padding="4">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="false">
                            <Setter TargetName="PART_Popup" Property="Height" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!-- PANEL & BORDER STYLES -->
    <!-- ========================================== -->

    <Style x:Key="CyberGlassPanel" TargetType="Border">
        <Setter Property="Background" Value="#1A1A2ECC"/>
        <Setter Property="BorderBrush" Value="#00D9FF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#00D9FF" BlurRadius="30" ShadowDepth="4" Opacity="0.3"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CyberCardPanel" TargetType="Border">
        <Setter Property="Background" Value="#1A1A2E"/>
        <Setter Property="BorderBrush" Value="#4A4A6A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="CyberTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource CyberPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#00D9FF" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CyberSubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource CyberTextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

</ResourceDictionary>
