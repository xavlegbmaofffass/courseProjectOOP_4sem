<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Основные цвета приложения — сине-фиолетовая неоновая тема -->
    <Color x:Key="PrimaryColor">#0A0A1E</Color>
    <Color x:Key="SecondaryColor">#1A0033</Color>
    <Color x:Key="AccentColor">#8E2DE2</Color>
    <Color x:Key="AccentColorHover">#4A00E0</Color>
    <Color x:Key="BackgroundColor">#0A0A1E</Color>
    <Color x:Key="CardBackgroundColor">#1A0033</Color>
    <Color x:Key="TextColor">#E0E0FF</Color>
    <Color x:Key="TextSecondaryColor">#B0B0FF</Color>
    <Color x:Key="CardBackground2Color">#151528</Color>
    <Color x:Key="BorderColor">#4A00E0</Color>
    <Color x:Key="SuccessColor">#4CAF50</Color>
    <Color x:Key="ErrorColor">#F44336</Color>
    <Color x:Key="WarningColor">#FF9800</Color>

    <!-- Кисти -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentColorHover}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="CardBackground2Brush" Color="{StaticResource CardBackground2Color}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

</ResourceDictionary>
