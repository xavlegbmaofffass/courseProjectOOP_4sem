<Application x:Class="FrontlineCardWarfare.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FrontlineCardWarfare"
             xmlns:viewmodels="clr-namespace:FrontlineCardWarfare.ViewModels"
             xmlns:views="clr-namespace:FrontlineCardWarfare.Views"
             xmlns:converters="clr-namespace:FrontlineCardWarfare.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Конвертеры -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:CardTypeToColorConverter x:Key="CardTypeToColorConverter"/>
            <converters:DifficultyDisplayConverter x:Key="DifficultyDisplayConverter"/>
            <converters:ResultToColorConverter x:Key="ResultToColorConverter"/>
            <converters:IndexConverter x:Key="IndexConverter"/>
            <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
            <converters:HealthPercentToWidthConverter x:Key="HealthPercentToWidthConverter"/>
            <converters:ImagePathConverter x:Key="ImagePathConverter"/>
            <converters:CardTypeToDisplayConverter x:Key="CardTypeToDisplayConverter"/>
            <converters:AbilityDescriptionConverter x:Key="AbilityDescriptionConverter"/>
            <converters:CardActionDescriptionConverter x:Key="CardActionDescriptionConverter"/>

            <!-- DataTemplates для навигации -->
            <DataTemplate DataType="{x:Type viewmodels:LoginViewModel}">
                <views:LoginView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:RegisterViewModel}">
                <views:RegisterView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:MainViewModel}">
                <views:MainView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:CollectionViewModel}">
                <views:CollectionView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:DeckBuilderViewModel}">
                <views:DeckBuilderView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:BattleViewModel}">
                <views:BattleView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:BattleSetupViewModel}">
                <views:BattleSetupView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:AdminViewModel}">
                <views:AdminView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:ProfileViewModel}">
                <views:ProfileView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:RulesViewModel}">
                <views:RulesView/>
            </DataTemplate>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/Buttons.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/GlobalStyles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/BattleStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
