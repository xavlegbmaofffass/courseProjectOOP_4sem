<UserControl x:Class="FrontlineCardWarfare.Controls.CardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:FrontlineCardWarfare.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="165" d:DesignWidth="100">
    
    <UserControl.Resources>
        <!-- Анимация появления карты (slide+fade, 0.3с) -->
        <Storyboard x:Key="CardAppearAnimation">
            <DoubleAnimation Storyboard.TargetName="CardBorder"
                            Storyboard.TargetProperty="Opacity"
                            From="0" To="1" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="CardTransform"
                            Storyboard.TargetProperty="Y"
                            From="50" To="0" Duration="0:0:0.3"/>
        </Storyboard>
    </UserControl.Resources>
    
    <Grid>
        <Border x:Name="CardBorder"
                Width="100" Height="165"
                CornerRadius="10"
                BorderThickness="2"
                BorderBrush="#0077B6"
                Background="#151525"
                RenderTransformOrigin="0.5, 0.5"
                MouseEnter="CardBorder_MouseEnter"
                MouseLeave="CardBorder_MouseLeave"
                MouseLeftButtonDown="CardBorder_MouseLeftButtonDown"
                DragOver="CardBorder_DragOver"
                Drop="CardBorder_Drop"
                AllowDrop="True"
                CacheMode="BitmapCache">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="CardTransform"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadow"
                                 Color="#0077B6"
                                 BlurRadius="10"
                                 ShadowDepth="0"
                                 Opacity="0.3"/>
            </Border.Effect>
            
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <!-- Hover State -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.1" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.1" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).Opacity" To="0.8" Duration="0:0:0.15"/>
                                        <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color" To="#FFFFFF" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).Opacity" To="0.3" Duration="0:0:0.15"/>
                                        <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color" To="#0077B6" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        
                        <!-- Pressed State (via MouseLeftButtonDown event usually, but we can use IsPressed if it were a button) -->
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <!-- Фон карты с градиентом -->
                <Border Background="#1A1A2E" CornerRadius="10"/>
                
                <!-- Градиентный оверлей -->
                <Border Background="#00000020" CornerRadius="10"/>
                
                <!-- Изображение юнита с отступом -->
                <Border Margin="6" CornerRadius="8" ClipToBounds="True">
                    <Image x:Name="CardImage"
                           Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}" 
                           Stretch="UniformToFill" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    </Image>
                </Border>
                
                <!-- Затемнение в верхней части для читаемости текста -->
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Верхний градиент (под статы) -->
                    <Border Grid.Row="0" Height="35" CornerRadius="4,4,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#AA000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
                
                <!-- Статы (верх) -->
                <Grid VerticalAlignment="Top" Margin="6">
                    <!-- Число атаки (сверху слева) -->
                    <Border Background="#FF4444"
                            CornerRadius="4"
                            Width="20" Height="20"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Attack}"
                                  FontSize="10"
                                  FontWeight="Bold"
                                  Foreground="#FFFFFF"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <!-- Число защиты/здоровья (сверху справа) -->
                    <Border Background="#4488FF"
                            CornerRadius="4"
                            Width="20" Height="20"
                            HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Health}"
                                  FontSize="10"
                                  FontWeight="Bold"
                                  Foreground="#FFFFFF"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Индикатор дальности -->
                <Border x:Name="RangeIndicator"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,10,10,0"
                       Background="#AA444444"
                       CornerRadius="4"
                       Padding="4,2"
                       Visibility="Collapsed">
                    <TextBlock Text="{Binding Range, StringFormat=📏 {0}}"
                              FontSize="10"
                              Foreground="#CCCCCC"/>
                </Border>
                
                <!-- Disabled оверлей -->
                <Border x:Name="DisabledOverlay"
                        Background="#AA000000"
                        CornerRadius="10"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"/>
                
                <!-- Индикатор неиграбельности -->
                <Border x:Name="NotPlayableOverlay"
                        Background="#80AA0000"
                        CornerRadius="10"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <TextBlock Text="❌ Невозможно разыграть"
                              FontSize="10"
                              FontWeight="Bold"
                              Foreground="#FFFFFF"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextAlignment="Center"
                              Margin="10"/>
                </Border>
                
                <!-- Индикатор уже использованной карты -->
                <Border x:Name="UsedOverlay"
                        Background="#80444444"
                        CornerRadius="10"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <TextBlock Text="✓"
                              FontSize="24"
                              FontWeight="Bold"
                              Foreground="#888888"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>