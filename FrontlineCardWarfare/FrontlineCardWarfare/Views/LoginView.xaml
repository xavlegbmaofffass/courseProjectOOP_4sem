<UserControl x:Class="FrontlineCardWarfare.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:FrontlineCardWarfare.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <Style x:Key="ModernInputBorder" TargetType="Border">
            <Setter Property="Background" Value="#0C0C18"/>
            <Setter Property="BorderBrush" Value="#1E1E32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="CaretBrush" Value="#00D9FF"/>
            <Setter Property="SelectionBrush" Value="#00D9FF40"/>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="CaretBrush" Value="#00D9FF"/>
            <Setter Property="SelectionBrush" Value="#00D9FF40"/>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00A8CC" Offset="0"/>
                        <GradientStop Color="#0077B6" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#7A7A9A"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#00D9FF"/>
                                <Setter Property="Background" Value="#00D9FF08"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ValidationText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#E84560"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Фоновое изображение -->
        <Image Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Opacity="0.6">
            <Image.Source>
                <BitmapImage UriSource="/Resources/Images/fon.jpeg" 
                             DecodePixelWidth="1920" 
                             CacheOption="OnLoad"/>
            </Image.Source>
        </Image>

        <!-- Форма по центру -->
        <Border MinWidth="400"
                MaxWidth="550"
                Width="Auto"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24,300,24,100"
                Style="{StaticResource OptimizedAnimatedElement}"
                Background="#0C0C18"
                BorderBrush="#151528"
                BorderThickness="1"
                CornerRadius="20"
                Padding="40,36"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="8" Opacity="0.5"/>
            </Border.Effect>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource GlobalCardAppearAnimation}"/>
                </EventTrigger>
            </Border.Triggers>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,28">
                    <TextBlock Text="Вход в систему"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#E0E0FF"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="Consolas"/>
                </StackPanel>

                <!-- Форма -->
                <StackPanel Grid.Row="1">
                    <!-- Имя пользователя -->
                    <TextBlock Text="ИМЯ ПОЛЬЗОВАТЕЛЯ"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#5c5cb2"
                               FontFamily="Consolas"
                               Margin="0,0,0,6"/>
                    <Border Style="{StaticResource ModernInputBorder}">
                        <Grid>
                            <TextBlock IsHitTestVisible="False"
                                       Text="Введите имя"
                                       Foreground="#5c5cb2"
                                       FontSize="20"
                                       Margin="14,12,0,0"
                                       VerticalAlignment="Top"
                                       Visibility="{Binding Username, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}"/>
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding UsernameValidation}"
                               Style="{StaticResource ValidationText}"
                               Visibility="{Binding HasUsernameError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Пароль -->
                    <TextBlock Text="ПАРОЛЬ"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#5c5cb2"
                               FontFamily="Consolas"
                               Margin="0,8,0,6"/>
                    <Border Style="{StaticResource ModernInputBorder}">
                        <Grid>
                            <TextBlock IsHitTestVisible="False"
                                       Text="Введите пароль"
                                       Foreground="#5c5cb2"
                                       FontSize="20"
                                       Margin="14,12,0,0"
                                       VerticalAlignment="Top"
                                       Visibility="{Binding Password, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}"/>
                            <PasswordBox x:Name="PasswordBox"
                                         Style="{StaticResource ModernPasswordBox}"
                                         PasswordChar="●"
                                         VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding PasswordValidation}"
                               Style="{StaticResource ValidationText}"
                               Visibility="{Binding HasPasswordError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Ошибка -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#E84560"
                               FontSize="19"
                               Margin="0,8,0,12"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Кнопка входа -->
                    <Button Content="ВОЙТИ"
                            Click="LoginButton_Click"
                            Style="{StaticResource PrimaryActionButton}"
                            Margin="0,8,0,16"
                            IsDefault="True"/>

                    <!-- Разделитель -->
                    <Grid Margin="0,0,0,16">
                        <Border Height="1" Background="#1E1E32"/>
                        <TextBlock Text="или"
                                   FontSize="15"
                                   Foreground="#5c5cb2"
                                   Background="#0C0C18"
                                   Padding="12,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Альтернативные действия -->
                    <StackPanel>
                        <Button Content="Создать аккаунт"
                                Command="{Binding RegisterCommand}"
                                Style="{StaticResource SecondaryActionButton}"/>
                        <Button Content="Войти как гость"
                                Command="{Binding GuestLoginCommand}"
                                Style="{StaticResource SecondaryActionButton}"
                                Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>