<UserControl x:Class="FrontlineCardWarfare.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:FrontlineCardWarfare.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1100"
             Background="#05050A">
    
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <conv:ResultToColorConverter x:Key="ResultToColorConverter"/>
        
        <!-- Modern Glass Effect Style -->
        <Style x:Key="GlassBorder" TargetType="Border">
            <Setter Property="Background" Value="#CC0D0D1A"/>
            <Setter Property="BorderBrush" Value="#2500D9FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCardHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#5A5A7A"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="StatCardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Primary Action Button (Modern Cyan) -->
        <Style x:Key="ModernPrimaryButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00D9FF" Offset="0"/>
                        <GradientStop Color="#0077B6" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#00D9FF" BlurRadius="12" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.3"/>
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button (Dark) -->
        <Style x:Key="ModernSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Foreground" Value="#8080A0"/>
            <Setter Property="BorderBrush" Value="#303A50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A3E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#505A70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber Input Style -->
        <Style x:Key="CyberInputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#05050A"/>
            <Setter Property="BorderBrush" Value="#1E1E32"/>
            <Setter Property="Foreground" Value="#E0E0FF"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#00D9FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D9FF"/>
                                <Setter TargetName="border" Property="Background" Value="#0A0A1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#05050A"/>
            <Setter Property="BorderBrush" Value="#1E1E32"/>
            <Setter Property="Foreground" Value="#E0E0FF"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#00D9FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D9FF"/>
                                <Setter TargetName="border" Property="Background" Value="#0A0A1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER: COMMANDER PROFILE -->
        <Grid Grid.Row="0" Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Width="80" Height="80" CornerRadius="40" Background="#151528" BorderBrush="#00D9FF" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect Color="#00D9FF" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <!-- Decorative Avatar placeholder -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <Ellipse Width="20" Height="20" Fill="#00D9FF" Opacity="0.6" Margin="0,0,0,6"/>
                        <Path Data="M 0,12 Q 20,0 40,12" Stroke="#00D9FF" StrokeThickness="3" Opacity="0.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                <TextBlock Text="ИДЕНТИФИКАЦИЯ_КОМАНДИРА" FontSize="10" FontWeight="Black" Foreground="#5A5A7A" FontFamily="Consolas"/>
                <TextBlock Text="{Binding CurrentUsername}" FontSize="36" FontWeight="Black" Foreground="#FFFFFF" Margin="0,-2,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00D9FF" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
                    </TextBlock.Effect>
                </TextBlock>
                <Border Background="#3000D9FF" CornerRadius="2" Padding="8,3" HorizontalAlignment="Left" Margin="0,4,0,0">
                    <TextBlock Text="СТАТУС: АКТИВЕН" FontSize="9" FontWeight="Bold" Foreground="#00D9FF" FontFamily="Consolas"/>
                </Border>
            </StackPanel>

            <Button Grid.Column="2" Content="ВЫЙТИ ИЗ АККАУНТА" 
                    Command="{Binding LogoutCommand}" 
                    Style="{StaticResource ModernSecondaryButton}"
                    VerticalAlignment="Top" BorderBrush="#30FF3860" Foreground="#AA6666"/>
        </Grid>

        <!-- CONTENT AREA -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDE: STATISTICS AND HISTORY -->
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    
                    <!-- SUMMARY STATS -->
                    <Border Style="{StaticResource GlassBorder}">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="ТАКТИЧЕСКАЯ_СТАТИСТИКА" FontSize="12" FontWeight="Black" Foreground="#00D9FF" FontFamily="Consolas"/>
                            </Grid>

                            <UniformGrid Columns="2">
                                <!-- WINS -->
                                <Border Background="#1000E676" CornerRadius="8" Padding="20" Margin="0,0,8,8" BorderBrush="#2000E676" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="УСПЕШНЫЕ_МИССИИ" Style="{StaticResource StatCardHeader}" Foreground="#8000E676"/>
                                        <TextBlock Text="{Binding Wins}" Style="{StaticResource StatCardValue}" Foreground="#00E676"/>
                                    </StackPanel>
                                </Border>
                                <!-- LOSSES -->
                                <Border Background="#10FF5252" CornerRadius="8" Padding="20" Margin="8,0,0,8" BorderBrush="#20FF5252" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ПРОВАЛЕННЫЕ_МИССИИ" Style="{StaticResource StatCardHeader}" Foreground="#80FF5252"/>
                                        <TextBlock Text="{Binding Losses}" Style="{StaticResource StatCardValue}" Foreground="#FF5252"/>
                                    </StackPanel>
                                </Border>
                                <!-- TOTAL -->
                                <Border Background="#10E0E0FF" CornerRadius="8" Padding="20" Margin="0,8,8,0" BorderBrush="#20E0E0FF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ВСЕГО_ОПЕРАЦИЙ" Style="{StaticResource StatCardHeader}"/>
                                        <TextBlock Text="{Binding TotalGames}" Style="{StaticResource StatCardValue}"/>
                                    </StackPanel>
                                </Border>
                                <!-- WINRATE -->
                                <Border Background="#1040C4FF" CornerRadius="8" Padding="20" Margin="8,8,0,0" BorderBrush="#2040C4FF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="РЕЙТИНГ_ЭФФЕКТИВНОСТИ" Style="{StaticResource StatCardHeader}" Foreground="#8040C4FF"/>
                                        <TextBlock Text="{Binding WinRate, StringFormat='{}{0:F1}%'}" Style="{StaticResource StatCardValue}" Foreground="#40C4FF"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- GAME HISTORY -->
                    <Border Style="{StaticResource GlassBorder}">
                        <StackPanel>
                            <TextBlock Text="ЖУРНАЛ_ПОСЛЕДНИХ_ОПЕРАЦИЙ" FontSize="12" FontWeight="Black" Foreground="#00D9FF" FontFamily="Consolas" Margin="0,0,0,20"/>
                            
                            <ItemsControl ItemsSource="{Binding GameHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0C0C18" BorderBrush="#1A1A2E" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <Border Width="4" Height="40" CornerRadius="2" 
                                                        Background="{Binding Result, Converter={StaticResource ResultToColorConverter}}"
                                                        VerticalAlignment="Center"/>
                                                
                                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                    <!-- Title and Opponent -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Result}" FontWeight="Black" FontSize="14" Foreground="#E0E0FF" Margin="0,0,12,0"/>
                                                        <TextBlock Text="VS " Foreground="#5A5A7A" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding OpponentName}" Foreground="#00D9FF" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Match Details Row -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Difficulty}" Foreground="#8080A0" FontSize="10" FontWeight="Bold"/>
                                                        <TextBlock Text=" • " Foreground="#303050" Margin="4,0"/>
                                                        
                                                        <!-- Duration -->
                                                        <TextBlock Text="⏱ " Foreground="#5A5A7A" FontSize="10"/>
                                                        <TextBlock Text="{Binding Duration, StringFormat=\{0:mm\\:ss\}}" Foreground="#A0A0B0" FontSize="10" FontWeight="Bold"/>
                                                        
                                                        <TextBlock Text=" • " Foreground="#303050" Margin="4,0"/>
                                                        
                                                        <!-- Damage Stats -->
                                                        <TextBlock Text="⚔ " Foreground="#4CAF50" FontSize="10" Margin="0,0,2,0"/>
                                                        <TextBlock Text="{Binding PlayerDamageDealt}" Foreground="#4CAF50" FontSize="10" FontWeight="Bold"/>
                                                        <TextBlock Text=" / " Foreground="#303050" FontSize="10" Margin="2,0"/>
                                                        <TextBlock Text="🛡 " Foreground="#F44336" FontSize="10" Margin="0,0,2,0"/>
                                                        <TextBlock Text="{Binding EnemyDamageDealt}" Foreground="#F44336" FontSize="10" FontWeight="Bold"/>
                                                        
                                                        <TextBlock Text=" • " Foreground="#303050" Margin="4,0"/>
                                                        
                                                        <!-- Turns -->
                                                        <TextBlock Text="ХОДОВ: " Foreground="#5A5A7A" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding TurnNumber}" Foreground="#E0E0FF" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                
                                                <!-- Date/Time -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DatePlayed, StringFormat=\{0:dd.MM.yyyy\}}" 
                                                               Foreground="#5c5cb2" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding DatePlayed, StringFormat=\{0:HH:mm\}}" 
                                                               Foreground="#3c3c6a" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="История игр не найдена." 
                                       Foreground="#5c5cb2" FontSize="12" FontStyle="Italic"
                                       HorizontalAlignment="Center" Margin="0,20"
                                       Visibility="{Binding GameHistory.Count, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Collapsed}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT SIDE: SETTINGS -->
                <StackPanel Grid.Column="1">
                    
                    <!-- SECURITY & PROFILE SETTINGS -->
                    <Border Style="{StaticResource GlassBorder}">
                        <StackPanel>
                            <TextBlock Text="БЕЗОПАСНОСТЬ_ПРОФИЛЯ" FontSize="12" FontWeight="Black" Foreground="#00D9FF" FontFamily="Consolas" Margin="0,0,0,24"/>

                            <!-- Change Username -->
                            <StackPanel Margin="0,0,0,32">
                                <TextBlock Text="СМЕНА_ПОЗЫВНОГО" FontSize="9" FontWeight="Bold" Foreground="#5A5A7A" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource CyberInputBox}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding UsernameValidation}" 
                                           Foreground="#FF5252" FontSize="11" Margin="4,0,0,12"
                                           Visibility="{Binding HasUsernameError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Content="ОБНОВИТЬ ИМЯ" 
                                        Command="{Binding UpdateProfileCommand}" 
                                        Style="{StaticResource ModernPrimaryButton}"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <Border Height="1" Background="#15FFFFFF" Margin="0,0,0,32"/>

                            <!-- Change Password -->
                            <StackPanel>
                                <TextBlock Text="СМЕНА_ПАРОЛЯ" FontSize="9" FontWeight="Bold" Foreground="#5A5A7A" Margin="0,0,0,20"/>
                                
                                <TextBlock Text="ТЕКУЩИЙ ПАРОЛЬ" FontSize="9" Foreground="#5c5cb2" FontWeight="Bold" Margin="4,0,0,4"/>
                                <PasswordBox x:Name="CurrentPasswordBox" Style="{StaticResource CyberPasswordBox}" Margin="0,0,0,16"/>

                                <TextBlock Text="НОВЫЙ ПАРОЛЬ" FontSize="9" Foreground="#5c5cb2" FontWeight="Bold" Margin="4,0,0,4"/>
                                <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource CyberPasswordBox}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding PasswordValidation}" 
                                           Foreground="#FF5252" FontSize="11" Margin="4,0,0,12"
                                           Visibility="{Binding HasPasswordError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <TextBlock Text="ПОДТВЕРДИТЕ НОВЫЙ ПАРОЛЬ" FontSize="9" Foreground="#5c5cb2" FontWeight="Bold" Margin="4,0,0,4"/>
                                <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource CyberPasswordBox}" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding ConfirmPasswordValidation}" 
                                           Foreground="#FF5252" FontSize="11" Margin="4,0,0,16"
                                           Visibility="{Binding HasConfirmPasswordError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <Button Content="СМЕНИТЬ ПАРОЛЬ" 
                                        Command="{Binding ChangePasswordCommand}" 
                                        Style="{StaticResource ModernPrimaryButton}"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Feedback Messages -->
                    <Border Background="#1000E676" BorderBrush="#3000E676" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                            Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" Foreground="#00E676" FontWeight="Black" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding SuccessMessage}" Foreground="#E0E0FF" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#10FF5252" BorderBrush="#30FF5252" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="!" Foreground="#FF5252" FontWeight="Black" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#E0E0FF" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- FOOTER: NAVIGATION -->
        <Border Grid.Row="2" Padding="0,24,0,0" BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0">
            <Button Content="← ВЕРНУТЬСЯ В ГЛАВНОЕ МЕНЮ" 
                    Command="{Binding BackToMenuCommand}" 
                    Style="{StaticResource ModernSecondaryButton}"
                    HorizontalAlignment="Left"/>
        </Border>
    </Grid>
</UserControl>