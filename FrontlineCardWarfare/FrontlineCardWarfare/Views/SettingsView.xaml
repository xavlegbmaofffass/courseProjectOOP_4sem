<UserControl x:Class="FrontlineCardWarfare.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="750">
    <UserControl.Resources>
        <!-- Локальная анимация удалена в пользу GlobalCardAppearAnimation -->

        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0FF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="toggleTrack"
                                    Grid.Column="0"
                                    Width="46"
                                    Height="24"
                                    Background="#1E1E32"
                                    CornerRadius="12"
                                    BorderBrush="#2A2A44"
                                    BorderThickness="1">
                                <Ellipse x:Name="toggleThumb"
                                         Width="18"
                                         Height="18"
                                         Fill="#4A4A6A"
                                         Margin="3,3,25,3"
                                         HorizontalAlignment="Left">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="16,0,0,0"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="toggleTrack" Property="Background" Value="#00A8CC20"/>
                                <Setter TargetName="toggleTrack" Property="BorderBrush" Value="#00A8CC60"/>
                                <Setter TargetName="toggleThumb" Property="Margin" Value="25,3,3,3"/>
                                <Setter TargetName="toggleThumb" Property="Fill" Value="#00D9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingPanel" TargetType="Border">
            <Setter Property="Background" Value="#0C0C18"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#1A1A2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#E0E0FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00A8CC" Offset="0"/>
                        <GradientStop Color="#0077B6" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6A6A8A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E0E0FF"/>
                                <Setter Property="Background" Value="#1A1A2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Фоновое изображение -->
        <Image Source="pack://application:,,,/Resources/Images/fon.jpeg"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Opacity="0.4"/>
        <Border Background="#000000" Opacity="0.5"/>

        <!-- Основная панель -->
        <Border Background="#0C0C18"
                BorderBrush="#151528"
                BorderThickness="1"
                CornerRadius="24"
                MaxWidth="680"
                Style="{StaticResource OptimizedAnimatedElement}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="40,80,40,80"
                Padding="36,32"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="8" Opacity="0.5"/>
            </Border.Effect>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource GlobalCardAppearAnimation}"/>
                </EventTrigger>
            </Border.Triggers>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="НАСТРОЙКИ СИСТЕМЫ"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#5c5cb2"
                               FontFamily="Consolas"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Параметры игры"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#E0E0FF"/>
                </StackPanel>

                <!-- Настройки -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Громкость звука -->
                        <Border Style="{StaticResource SettingPanel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="Громкость звука"/>
                                    <TextBlock Text="Общая громкость звуковых эффектов и музыки"
                                               FontSize="16" Foreground="#5A5A7A" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SoundVolume, StringFormat={}{0}%}"
                                               FontSize="14" Foreground="#00D9FF" 
                                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <Slider Value="{Binding SoundVolume}" Minimum="0" Maximum="100"
                                            HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingPanel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="Полноэкранный режим"/>
                                    <TextBlock Text="Запускать игру в полном экране"
                                               FontSize="16" Foreground="#5A5A7A" Margin="0,4,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsFullscreen}"
                                          Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Кнопки -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button Content="Сохранить" Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryActionButton}" Margin="0,0,12,0"/>
                    <Button Content="Назад в меню" Command="{Binding BackToMenuCommand}"
                            Style="{StaticResource SecondaryActionButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>