<UserControl x:Class="FrontlineCardWarfare.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:FrontlineCardWarfare.Converters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            
            <Storyboard x:Key="PanelAppear">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5">
                    <DoubleAnimation.EasingFunction>
                        <QuarticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" 
                                 From="0.97" To="1" Duration="0:0:0.5">
                    <DoubleAnimation.EasingFunction>
                        <QuarticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- Стили для таблиц -->
            <Style x:Key="AdminDataGrid" TargetType="DataGrid">
                <Setter Property="Background" Value="#0A0A12"/>
                <Setter Property="Foreground" Value="{StaticResource CyberTextPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="RowHeight" Value="52"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="AlternatingRowBackground" Value="#0F0F1A"/>
            </Style>

            <Style x:Key="AdminDataGridHeader" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#151528"/>
                <Setter Property="Foreground" Value="{StaticResource CyberPrimaryBrush}"/>
                <Setter Property="FontWeight" Value="ExtraBold"/>
                <Setter Property="Padding" Value="8,10"/>
                <Setter Property="BorderBrush" Value="{StaticResource CyberPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                <Setter Property="FontSize" Value="10"/>
            </Style>

            <Style x:Key="AdminDataGridRow" TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="#1E1E32"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1A1A32"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#252545"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TabButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource CyberTextSecondaryBrush}"/>
                <Setter Property="Padding" Value="28,14"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    BorderThickness="0,0,0,4"
                                    BorderBrush="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="InputLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource CyberTextSecondaryBrush}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Opacity" Value="0.8"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource CyberDarkBrush}">
        <!-- Фоновый эффект -->
        <Image Source="pack://application:,,,/Resources/Images/fon.jpeg"
               Stretch="UniformToFill" Opacity="0.15"/>
        
        <Border Style="{StaticResource CyberGlassPanel}"
                MaxWidth="1350" MaxHeight="880"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource PanelAppear}"/>
                </EventTrigger>
            </Border.Triggers>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock Text="FRONT-LINE: COMMAND CENTER" 
                                   FontSize="12" FontWeight="Black" 
                                   Foreground="{StaticResource CyberSecondaryBrush}" 
                                   FontFamily="Consolas" Opacity="0.9"/>
                        <TextBlock Text="УПРАВЛЕНИЕ СИСТЕМОЙ" 
                                   Style="{StaticResource CyberTitleText}"
                                   FontSize="42"/>
                    </StackPanel>
                    <Button Content="ВЫХОД ИЗ ТЕРМИНАЛА" 
                            Command="{Binding BackToMenuCommand}"
                            Style="{StaticResource CyberBackButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Padding="20,12"/>
                </Grid>

                <!-- TABS -->
                <Border Grid.Row="1" Background="#0A0A12" CornerRadius="8" Margin="0,0,0,25" Padding="5">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="📁 РЕЕСТР ЮНИТОВ"
                                Command="{Binding SwitchToCardsTabCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCardsTabVisible}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource CyberPrimaryBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource CyberPrimaryBrush}"/>
                                            <Setter Property="Background" Value="#121225"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="👥 БАЗА ОПЕРАТИВНИКОВ"
                                Command="{Binding SwitchToUsersTabCommand}"
                                Margin="10,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUsersTabVisible}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource CyberPrimaryBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource CyberPrimaryBrush}"/>
                                            <Setter Property="Background" Value="#121225"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- CONTENT -->
                <Grid Grid.Row="2">
                    <!-- CARDS TAB -->
                    <Grid Visibility="{Binding IsCardsTabVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- EDITOR -->
                        <Border Grid.Column="0" Style="{StaticResource CyberCardPanel}" Background="#080810">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2">
                                <StackPanel>
                                    <Grid Margin="0,0,0,25">
                                        <TextBlock Text="РЕДАКТОР ЮНИТА" 
                                                   FontSize="20" FontWeight="Black" 
                                                   Foreground="{StaticResource CyberPrimaryBrush}"
                                                   Visibility="{Binding IsEditingCard, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                        <TextBlock Text="ПРАВКА ОБЪЕКТА" 
                                                   FontSize="20" FontWeight="Black" 
                                                   Foreground="{StaticResource CyberSecondaryBrush}"
                                                   Visibility="{Binding IsEditingCard, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>

                                    <TextBlock Text="ПОЗЫВНОЙ (НАЗВАНИЕ)" Style="{StaticResource InputLabel}"/>
                                    <TextBox Style="{StaticResource CyberTextBox}"
                                             Text="{Binding NewCardName, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,18"/>

                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="АТАКА (УРН)" Style="{StaticResource InputLabel}"/>
                                            <TextBox Style="{StaticResource CyberTextBox}"
                                                     Text="{Binding NewCardAttack, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="ЗАЩИТА (ХП)" Style="{StaticResource InputLabel}"/>
                                            <TextBox Style="{StaticResource CyberTextBox}"
                                                     Text="{Binding NewCardHealth, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,18">
                                        <StackPanel>
                                            <TextBlock Text="ДИСТАНЦИЯ" Style="{StaticResource InputLabel}"/>
                                            <TextBox Style="{StaticResource CyberTextBox}"
                                                     Text="{Binding NewCardRange, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="КЛАССИФИКАЦИЯ" Style="{StaticResource InputLabel}"/>
                                    <ComboBox Style="{StaticResource CyberComboBox}"
                                              SelectedItem="{Binding NewCardType, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding CardTypes}"
                                              Margin="0,0,0,18" HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource CardTypeToDisplayConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="ТАКТИЧЕСКИЕ ДАННЫЕ" Style="{StaticResource InputLabel}"/>
                                    <TextBox Style="{StaticResource CyberTextBox}"
                                             Text="{Binding NewCardDescription, UpdateSourceTrigger=PropertyChanged}"
                                             Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                                             Margin="0,0,0,30"/>

                                    <Button Content="ВНЕСТИ В РЕЕСТР"
                                            Command="{Binding AddCardCommand}"
                                            Style="{StaticResource CyberSuccessButton}"
                                            Height="54"
                                            Visibility="{Binding IsEditingCard, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    
                                    <StackPanel Visibility="{Binding IsEditingCard, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button Content="ПОДТВЕРДИТЬ ИЗМЕНЕНИЯ"
                                                Command="{Binding SaveCardCommand}"
                                                Style="{StaticResource CyberPrimaryButton}"
                                                Height="54" Margin="0,0,0,12"/>
                                        <Button Content="ОТМЕНА"
                                                Command="{Binding CancelEditCommand}"
                                                Style="{StaticResource CyberBackButton}"
                                                HorizontalAlignment="Stretch"
                                                Height="48"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- LIST -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- SEARCH -->
                            <Border Grid.Row="0" Style="{StaticResource CyberCardPanel}" Background="#080810" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Grid Grid.Column="0">
                                        <TextBox Style="{StaticResource CyberTextBox}"
                                                 x:Name="SearchBox"
                                                 Text="{Binding CardSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="🔍 Фильтрация по кодовому имени..."
                                                   Foreground="#5c5cb2" FontSize="14"
                                                   VerticalAlignment="Center" Margin="18,0,0,0"
                                                   IsHitTestVisible="False"
                                                   Visibility="{Binding CardSearchText, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                    </Grid>

                                    <ComboBox Grid.Column="2" 
                                              Style="{StaticResource CyberComboBox}"
                                              SelectedItem="{Binding CardFilterType, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding CardTypes}"
                                              Height="50" MinWidth="180">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource CardTypeToDisplayConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    
                                    <Button Grid.Column="4" Content="ПРИМЕНИТЬ ФИЛЬТР" 
                                            Command="{Binding SearchCardsCommand}"
                                            Style="{StaticResource CyberPrimaryButton}"
                                            Padding="35,0" Height="50" FontSize="14"/>
                                </Grid>
                            </Border>

                            <!-- GRID -->
                            <Border Grid.Row="1" Style="{StaticResource CyberCardPanel}" Padding="0" Background="#05050A">
                                <DataGrid ItemsSource="{Binding Cards}"
                                          SelectedItem="{Binding SelectedCard}"
                                          Style="{StaticResource AdminDataGrid}">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AdminDataGridHeader}"/>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource AdminDataGridRow}"/>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ПОЗЫВНОЙ" Binding="{Binding Name}" Width="250">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Margin" Value="10,0,0,0"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="КЛАСС" Binding="{Binding CardType}" Width="100"/>
                                        <DataGridTextColumn Header="УРН" Binding="{Binding Attack}" Width="50"/>
                                        <DataGridTextColumn Header="ХП" Binding="{Binding Health}" Width="50"/>
                                        <DataGridTextColumn Header="ДАЛ" Binding="{Binding Range}" Width="50"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- ACTIONS -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                <Button Content="МОДИФИЦИРОВАТЬ"
                                        Command="{Binding EditCardCommand}"
                                        Style="{StaticResource CyberPrimaryButton}"
                                        Padding="35,14" FontSize="14"
                                        IsEnabled="{Binding SelectedCard, Converter={StaticResource NullToBoolConverter}}"/>
                                <Button Content="ДЕАКТИВИРОВАТЬ"
                                        Command="{Binding DeleteCardCommand}"
                                        Style="{StaticResource CyberDangerButton}"
                                        Padding="35,14" FontSize="14"
                                        Margin="15,0,0,0"
                                        IsEnabled="{Binding SelectedCard, Converter={StaticResource NullToBoolConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- USERS TAB -->
                    <Grid Visibility="{Binding IsUsersTabVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="380"/>
                        </Grid.ColumnDefinitions>

                        <!-- USER GRID -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource CyberCardPanel}" Padding="0" Background="#05050A">
                                <DataGrid ItemsSource="{Binding Users}"
                                          SelectedItem="{Binding SelectedUser}"
                                          Style="{StaticResource AdminDataGrid}"
                                          HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AdminDataGridHeader}"/>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource AdminDataGridRow}"/>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                        <DataGridTextColumn Header="ОПЕРАТИВНИК" Binding="{Binding Username}" Width="150">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="10,0,0,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="УРОВЕНЬ ДОСТУПА" Binding="{Binding Role}" Width="140"/>
                                        
                                        <!-- СТАТИСТИКА В ТАБЛИЦЕ -->
                                        <DataGridTextColumn Header="ИГР" Binding="{Binding Statistics.TotalGames}" Width="60">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="W/R %" Binding="{Binding Statistics.WinRate, StringFormat={}{0:F1}%}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTemplateColumn Header="СТАТУС" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="#00FF95"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                                            <Setter Property="Fill" Value="#FF3860"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="АКТИВЕН"/>
                                                                    <Setter Property="Foreground" Value="#00FF95"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                                            <Setter Property="Text" Value="ЗАБЛ."/>
                                                                            <Setter Property="Foreground" Value="#FF3860"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <Button Grid.Row="1" Content="ИЗМЕНИТЬ СТАТУС ДОСТУПА"
                                    Command="{Binding ToggleBlockUserCommand}"
                                    Style="{StaticResource CyberDangerButton}"
                                    HorizontalAlignment="Left"
                                    Height="56" Padding="40,0"
                                    Margin="0,20,0,0"
                                    IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToBoolConverter}}"/>
                        </Grid>

                        <!-- STATISTICS PANEL -->
                        <Border Grid.Column="2" Style="{StaticResource CyberCardPanel}" Background="#080810">
                            <Grid>
                                <!-- EMPTY STATE -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding SelectedUser, Converter={StaticResource NullToBoolConverter}, ConverterParameter=Invert}">
                                    <TextBlock Text="👤" FontSize="64" HorizontalAlignment="Center" Opacity="0.2"/>
                                </StackPanel>

                                <!-- DETAILS -->
                                <StackPanel Visibility="{Binding SelectedUser, Converter={StaticResource NullToBoolConverter}}">
                                    <TextBlock Text="ДОСЬЕ ОПЕРАТИВНИКА" FontSize="20" FontWeight="Black" 
                                               Foreground="{StaticResource CyberPrimaryBrush}" Margin="0,0,0,25"/>

                                    <Border Background="#121225" CornerRadius="8" Padding="20" Margin="0,0,0,25">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedUser.Username, StringFormat='ПОЗЫВНОЙ: {0}'}" 
                                                       FontSize="18" FontWeight="Bold" Foreground="{StaticResource CyberTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedUser.Role, StringFormat='УРОВЕНЬ: {0}'}" 
                                                       Style="{StaticResource InputLabel}" Margin="0,5,0,0"/>
                                            <Separator Background="#1E1E32" Margin="0,15"/>
                                            <TextBlock Text="{Binding SelectedUser.CreatedAt, StringFormat='ЗАРЕГИСТРИРОВАН: {0:dd.MM.yyyy HH:mm}'}" 
                                                       FontSize="12" Foreground="{StaticResource CyberTextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="БОЕВАЯ ЭФФЕКТИВНОСТЬ" Style="{StaticResource InputLabel}"/>
                                    
                                    <Grid Margin="0,10,0,25">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Column="0" Background="#0A2A1A" CornerRadius="6" Padding="15" Margin="0,0,5,5">
                                            <StackPanel>
                                                <TextBlock Text="ПОБЕД" FontSize="11" Foreground="#00FF95" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SelectedUser.Statistics.Wins}" FontSize="24" FontWeight="Black" Foreground="#00FF95"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Background="#2A0A0A" CornerRadius="6" Padding="15" Margin="5,0,0,5">
                                            <StackPanel>
                                                <TextBlock Text="ПОРАЖЕНИЙ" FontSize="11" Foreground="#FF3860" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SelectedUser.Statistics.Losses}" FontSize="24" FontWeight="Black" Foreground="#FF3860"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="0" Background="#1A1A32" CornerRadius="6" Padding="15" Margin="0,5,5,0">
                                            <StackPanel>
                                                <TextBlock Text="ВСЕГО ИГР" FontSize="11" Foreground="{StaticResource CyberTextSecondaryBrush}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SelectedUser.Statistics.TotalGames}" FontSize="24" FontWeight="Black" Foreground="{StaticResource CyberTextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="1" Background="#1A1A32" CornerRadius="6" Padding="15" Margin="5,5,0,0">
                                            <StackPanel>
                                                <TextBlock Text="WIN RATE" FontSize="11" Foreground="{StaticResource CyberPrimaryBrush}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SelectedUser.Statistics.WinRate, StringFormat={}{0:F1}%}" FontSize="24" FontWeight="Black" Foreground="{StaticResource CyberPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="ПОСЛЕДНЯЯ АКТИВНОСТЬ" Style="{StaticResource InputLabel}"/>
                                    <Border Background="#0A0A15" BorderBrush="#1A1A32" BorderThickness="1" CornerRadius="6" Padding="15">
                                        <TextBlock Text="{Binding SelectedUser.Statistics.LastPlayedAt, StringFormat=\{0:dd.MM.yyyy HH:mm\}, TargetNullValue='---'}" 
                                                   FontSize="14" Foreground="{StaticResource CyberTextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    </Border>
                                    
                                    <TextBlock Text="* Статистика обновляется автоматически после каждой завершенной сессии." 
                                               FontSize="10" Foreground="{StaticResource CyberTextSecondaryBrush}" 
                                               FontStyle="Italic" TextWrapping="Wrap" Margin="0,20,0,0" Opacity="0.6"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>