<UserControl x:Class="FrontlineCardWarfare.Views.BattleSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:FrontlineCardWarfare.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#05050A">
    <UserControl.Resources>
        <conv:DifficultyDisplayConverter x:Key="DifficultyDisplayConverter"/>

        <!-- Glass Effect Style -->
        <Style x:Key="SetupGlassBorder" TargetType="Border">
            <Setter Property="Background" Value="#CC0D0D1A"/>
            <Setter Property="BorderBrush" Value="#2500D9FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="40"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean ComboBox Style -->
        <Style x:Key="CleanComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#0A0A1F"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A2A44"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                            <Grid TextElement.Foreground="{TemplateBinding Foreground}">
                                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="20,12,44,12"/>
                                                <Path Data="M 0 0 L 5 5 L 10 0 Z"
                                                      Fill="#00D9FF"
                                                      HorizontalAlignment="Right"
                                                      Margin="0,0,20,0"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Background="#121225"
                                        BorderBrush="#00D9FF40"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Padding="4">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="18,14"/>
                    <Setter Property="Foreground" Value="#E0E0FF"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="itemBorder" Property="Background" Value="#1A1A3E"/>
                                        <Setter Property="Foreground" Value="#00D9FF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="itemBorder" Property="Background" Value="#2000D9FF"/>
                                        <Setter Property="Foreground" Value="#00D9FF"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00D9FF" Offset="0"/>
                        <GradientStop Color="#0077B6" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="60,20"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="#00D9FF" BlurRadius="25" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6A6A8A"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E0E0FF"/>
                                <Setter Property="Background" Value="#1A1A2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Фоновое изображение -->
        <Image Source="pack://application:,,,/Resources/Images/fon.jpeg"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Opacity="0.3"/>

        <!-- Затемнение -->
        <Border Background="#000000" Opacity="0.5"/>

        <!-- Основная панель -->
        <Border Style="{StaticResource SetupGlassBorder}"
                MaxWidth="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            
            <StackPanel>
                <!-- Заголовок -->
                <TextBlock Text="ПОДГОТОВКА К БОЮ" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00D9FF" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Информация о колоде -->
                <Border Background="#080815" 
                        BorderBrush="#1A1A2E" 
                        BorderThickness="1" 
                        CornerRadius="16" 
                        Padding="24" 
                        Margin="0,0,0,32">
                    <StackPanel>
                        <TextBlock Text="ВАША КОЛОДА" 
                                   FontSize="12" 
                                   FontWeight="Bold" 
                                   Foreground="#5A5A7A" 
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding PlayerDeckName}" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   Foreground="#00D9FF"/>
                    </StackPanel>
                </Border>

                <!-- Выбор сложности -->
                <StackPanel Margin="0,0,0,32">
                    <TextBlock Text="УРОВЕНЬ СЛОЖНОСТИ" 
                               FontSize="12" 
                               FontWeight="Bold" 
                               Foreground="#5A5A7A" 
                               Margin="0,0,0,12"/>
                    <ComboBox ItemsSource="{Binding Difficulties}"
                              SelectedItem="{Binding SelectedDifficulty}"
                              Style="{StaticResource CleanComboBox}"/>
                </StackPanel>

                <!-- Описание сложности -->
                <Border Background="#0A0A1A" 
                        CornerRadius="12" 
                        Padding="20" 
                        Margin="0,0,0,40"
                        BorderBrush="#15FFFFFF"
                        BorderThickness="1">
                    <TextBlock Text="{Binding SelectedDifficulty, Converter={StaticResource DifficultyDisplayConverter}}"
                               FontSize="16" 
                               Foreground="#8080A0" 
                               TextWrapping="Wrap" 
                               LineHeight="22"
                               TextAlignment="Center"/>
                </Border>

                <!-- Кнопки действий -->
                <StackPanel>
                    <Button Content="ВСТУПИТЬ В БОЙ"
                            Command="{Binding StartBattleCommand}"
                            Style="{StaticResource PrimaryActionButton}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,16"/>

                    <Button Content="← Назад в меню"
                            Command="{Binding BackToMenuCommand}"
                            Style="{StaticResource SecondaryActionButton}"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>