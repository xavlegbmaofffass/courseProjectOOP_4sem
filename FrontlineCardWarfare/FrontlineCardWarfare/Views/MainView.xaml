<UserControl x:Class="FrontlineCardWarfare.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:FrontlineCardWarfare.Converters"
             xmlns:data="clr-namespace:FrontlineCardWarfare.Data"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Плавная анимация появления -->
        <Storyboard x:Key="MenuAppear" Timeline.DesiredFrameRate="60">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="60" To="0" Duration="0:0:1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="ProfileAppear" Timeline.DesiredFrameRate="60">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="LogoAppear" Timeline.DesiredFrameRate="60">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1.2">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.85" To="1" Duration="0:0:1.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.85" To="1" Duration="0:0:1.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Стиль кнопки меню -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,16"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="Transparent"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="indicator"
                                        Grid.Column="0"
                                        Width="3"
                                        Height="0"
                                        Background="#00D9FF"
                                        CornerRadius="1.5"
                                        Opacity="0"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                                <Path x:Name="arrow"
                                      Grid.Column="2"
                                      Data="M 0 0 L 5 4 L 10 0 Z"
                                      Fill="#00D9FF"
                                      Opacity="0"
                                      VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00D9FF06"/>
                                <Setter TargetName="indicator" Property="Opacity" Value="1"/>
                                <Setter TargetName="indicator" Property="Height" Value="20"/>
                                <Setter TargetName="arrow" Property="Opacity" Value="0.7"/>
                                <Setter Property="Foreground" Value="#E0E0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="#00D9FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5c5cb2"/>
                                <Setter TargetName="indicator" Property="Opacity" Value="0"/>
                                <Setter TargetName="arrow" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentMenuButton" TargetType="Button" BasedOn="{StaticResource MenuButton}">
            <Setter Property="Background" Value="#00D9FF08"/>
            <Setter Property="Foreground" Value="#00D9FF"/>
            <Setter Property="BorderBrush" Value="#00D9FF15"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DangerMenuButton" TargetType="Button" BasedOn="{StaticResource MenuButton}">
            <Setter Property="Foreground" Value="#FF6B7A"/>
        </Style>

        <!-- ComboBox -->
        <Style x:Key="DeckComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#0C0C18"/>
            <Setter Property="Foreground" Value="#E0E0FF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A2A44"/>
            <Setter Property="MinWidth" Value="300"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate DataType="{x:Type data:Deck}">
                        <TextBlock Text="{Binding Name}" Foreground="#E0E0FF" FontSize="18"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Background="#121220"
                                        BorderBrush="#00D9FF50"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer Padding="4">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <ToggleButton x:Name="toggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Padding="0"
                                          Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                            <Grid>
                                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="14,0,32,0"/>
                                                <Path Data="M 0 0 L 5 4 L 10 0 Z"
                                                      Fill="#00D9FF"
                                                      HorizontalAlignment="Right"
                                                      Margin="0,0,14,0"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Фоновое изображение -->
        <Image Source="pack://application:,,,/Resources/Images/fon.jpeg"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

        <!-- Профиль в левом верхнем углу -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24,20,0,0"
                Style="{StaticResource OptimizedAnimatedElement}"
                Background="#0C0C18"
                BorderBrush="#1A1A2E"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,12"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform X="0" Y="0"/>
            </Border.RenderTransform>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource ProfileAppear}"/>
                </EventTrigger>
            </Border.Triggers>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WelcomeMessage}"
                               FontSize="17"
                               Foreground="#E0E0FF"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Администратор"
                               FontSize="15"
                               Foreground="#5A5A7A"
                               Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Центральная панель меню -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24,300,24,0"
                Style="{StaticResource OptimizedAnimatedElement}"
                Background="#0C0C18"
                BorderBrush="#151528"
                BorderThickness="1"
                CornerRadius="24"
                Padding="40,25"
                MaxWidth="400"
                Width="Auto"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform X="0" Y="0"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.5"/>
            </Border.Effect>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource MenuAppear}"/>
                </EventTrigger>
            </Border.Triggers>
            <StackPanel>
            <!-- Меню -->
                <StackPanel>
                    <Button Content="НАЧАТЬ БОЙ"
                            Command="{Binding StartBattleCommand}"
                            Style="{StaticResource AccentMenuButton}"/>

                    <Button Content="КОНСТРУКТОР КОЛОД"
                            Command="{Binding OpenDeckBuilderCommand}"
                            Style="{StaticResource MenuButton}"/>

                    <Button Content="КОЛЛЕКЦИЯ КАРТ"
                            Command="{Binding OpenCollectionCommand}"
                            Style="{StaticResource MenuButton}"/>

                    <Button Content="ПРАВИЛА ИГРЫ"
                            Command="{Binding OpenRulesCommand}"
                            Style="{StaticResource MenuButton}"/>

                    <Button Content="ПРОФИЛЬ"
                            Command="{Binding OpenProfileCommand}"
                            Style="{StaticResource MenuButton}"
                            Visibility="{Binding IsGuestMode, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                    <Button Content="НАСТРОЙКИ"
                            Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource MenuButton}"/>

                    <Button Content="ПАНЕЛЬ АДМИНИСТРАТОРА"
                            Command="{Binding OpenAdminPanelCommand}"
                            Style="{StaticResource DangerMenuButton}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Разделитель -->
                <Border Height="1" Margin="32,16,32,12" Background="#1A1A2E"/>

                <!-- Выбор колоды -->
                <StackPanel>
                    <TextBlock Text="АКТИВНАЯ КОЛОДА"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#5c5cb2"
                               FontFamily="Consolas"
                               Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding PlayerDecks}"
                              SelectedItem="{Binding SelectedDeck}"
                              Style="{StaticResource DeckComboBox}"/>
                    <TextBlock Text="{Binding DeckCountText}"
                               FontSize="15"
                               Foreground="#4A4A6A"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Разделитель -->
                <Border Height="1" Margin="32,12,32,0" Background="#1A1A2E"/>

                <!-- Выход -->
                <Button Content="ВЫЙТИ ИЗ СИСТЕМЫ"
                        Command="{Binding LogoutCommand}"
                        Style="{StaticResource DangerMenuButton}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>