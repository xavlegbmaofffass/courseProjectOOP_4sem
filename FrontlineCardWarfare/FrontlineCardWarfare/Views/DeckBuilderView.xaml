<UserControl x:Class="FrontlineCardWarfare.Views.DeckBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:data="clr-namespace:FrontlineCardWarfare.Data"
             xmlns:conv="clr-namespace:FrontlineCardWarfare.Converters"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1150">
    <UserControl.Resources>
        <conv:CardTypeToColorConverter x:Key="CardTypeToColorConverter"/>
        <conv:CardTypeToDisplayConverter x:Key="CardTypeToDisplayConverter"/>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
        <conv:CardActionDescriptionConverter x:Key="CardActionDescriptionConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0F0F1A"/>
            <Setter Property="Foreground" Value="#E0E0FF"/>
            <Setter Property="BorderBrush" Value="#1E1E32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="CaretBrush" Value="#FF00E5"/>
            <Setter Property="SelectionBrush" Value="#FF00E540"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#0F0F1A"/>
            <Setter Property="Foreground" Value="#E0E0FF"/>
            <Setter Property="BorderBrush" Value="#1E1E32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding SelectionBoxItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"/>
                                                <Path Grid.Column="1"
                                                      x:Name="Arrow"
                                                      Fill="#8A8AA0"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Stretch="Uniform"
                                                      Width="10"
                                                      Height="6"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arrow" Property="Fill" Value="#E0E0FF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Data" Value="M 0 4 L 4 0 L 8 4 Z"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#0F0F1A"
                                            BorderBrush="#1E1E32"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="#E0E0FF"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="12,10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1A1A2E"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1E1E3A"/>
                                        <Setter Property="Foreground" Value="#FF00E5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#C71585" Offset="0"/>
                        <GradientStop Color="#8B008B" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#3A3A4A"/>
                                <Setter Property="Foreground" Value="#6A6A7A"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Foreground" Value="#8A8AA0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A2A44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#4A4A6A"/>
                                <Setter Property="Foreground" Value="#E0E0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerActionButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#E84560" Offset="0"/>
                        <GradientStop Color="#C0392B" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AvailableCardTemplate" DataType="{x:Type data:Card}">
            <Border x:Name="cardBorder"
                    Background="#0F0F1A"
                    CornerRadius="14"
                    Padding="12"
                    Margin="8"
                    BorderBrush="#1A1A2E"
                    BorderThickness="1"
                    Width="190"
                    Cursor="Hand"
                    MouseLeftButtonUp="AvailableCard_MouseLeftButtonUp"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.35"/>
                </Border.Effect>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Mouse.MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="cardBorder"
                                                 Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.03"
                                                 Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="cardBorder"
                                                 Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.03"
                                                 Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <ColorAnimation Storyboard.TargetName="cardBorder"
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                To="#FF00E5"
                                                Duration="0:0:0.25">
                                    <ColorAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Mouse.MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="cardBorder"
                                                 Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1"
                                                 Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="cardBorder"
                                                 Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1"
                                                 Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <ColorAnimation Storyboard.TargetName="cardBorder"
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                To="#1A1A2E"
                                                Duration="0:0:0.25">
                                    <ColorAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="190"/>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#080810"
                            CornerRadius="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}"
                               Stretch="Uniform"
                               MaxHeight="190"
                               MaxWidth="190"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Row="1" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center"
                                Margin="0,3,0,2">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#E0E0FF"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="28"
                                   LineHeight="14"/>
                        <TextBlock Text="{Binding CardType, Converter={StaticResource CardTypeToDisplayConverter}}"
                                   FontSize="14"
                                   Foreground="{Binding CardType, Converter={StaticResource CardTypeToColorConverter}}"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Margin="0,1,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="2" 
                            Background="#08081040"
                            CornerRadius="6"
                            Padding="4,3"
                            Margin="0,1,0,2">
                        <TextBlock Text="{Binding Converter={StaticResource CardActionDescriptionConverter}}"
                                   FontSize="14"
                                   Foreground="#9A9AB0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextTrimming="WordEllipsis"
                                   VerticalAlignment="Center"
                                   LineHeight="13"/>
                    </Border>

                    <UniformGrid Grid.Row="3" Columns="3" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <Border Background="#00A8CC15" CornerRadius="6" Padding="3,2" Margin="1,0" BorderBrush="#00A8CC30" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⚔" FontSize="14" VerticalAlignment="Center" Margin="0,0,1,0" Foreground="#00D9FF"/>
                                <TextBlock Text="{Binding Attack}" FontSize="15" Foreground="#00D9FF" FontWeight="Bold" FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#E8456015" CornerRadius="6" Padding="3,2" Margin="1,0" BorderBrush="#E8456030" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="❤" FontSize="14" VerticalAlignment="Center" Margin="0,0,1,0" Foreground="#E84560"/>
                                <TextBlock Text="{Binding Health}" FontSize="15" Foreground="#E84560" FontWeight="Bold" FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFD70015" CornerRadius="6" Padding="3,2" Margin="1,0" BorderBrush="#FFD70030" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🏹" FontSize="14" VerticalAlignment="Center" Margin="0,0,1,0" Foreground="#FFD700"/>
                                <TextBlock Text="{Binding Range}" FontSize="15" Foreground="#FFD700" FontWeight="Bold" FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Фон -->
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.3,0.3">
                    <GradientStop Color="#0D0D1A" Offset="0"/>
                    <GradientStop Color="#080810" Offset="0.7"/>
                    <GradientStop Color="#050508" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Контент -->
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,16,16">
                <TextBlock Text="КОНСТРУКТОР КОЛОД"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#4A4A6A"
                           FontFamily="Consolas"
                           Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrentDeckName}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#E0E0FF"
                               VerticalAlignment="Center"/>
                    
                    <Button Content="Редактировать существующую колоду"
                            Command="{Binding EditExistingDeckCommand}"
                            Style="{StaticResource SecondaryActionButton}"
                            Margin="20,0,0,0"
                            Padding="12,6"
                            FontSize="14"/>
                    
                    <ComboBox ItemsSource="{Binding UserDecks}"
                              SelectedItem="{Binding SelectedUserDeck}"
                              Width="220"
                              Margin="12,0,0,0"
                              Style="{StaticResource ModernComboBox}"
                              Visibility="{Binding IsEditModeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <!-- Статистика колоды -->
            <StackPanel Grid.Column="1" Grid.Row="0" HorizontalAlignment="Right" Margin="0,0,0,16">
                <Border Background="#0F0F1A" CornerRadius="12" Padding="20,14" BorderBrush="#1A1A2E" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="КАРТ В КОЛОДЕ"
                                   FontSize="14"
                                   Foreground="#4A4A6A"
                                   HorizontalAlignment="Center"
                                   FontFamily="Consolas"/>
                        <TextBlock Text="{Binding CardCount, StringFormat={}{0} / 30}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#FF00E5"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"
                                   FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Доступные карты -->
            <Grid Grid.Column="0" Grid.Row="1" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Панель фильтров -->
                <Border Grid.Row="0" Background="#0F0F1A" CornerRadius="12" Padding="14" Margin="0,0,0,12" BorderBrush="#1A1A2E" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="200" Margin="0,0,10,0">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Text="Введите название карты..." 
                                       Foreground="#4A4A6A"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ComboBox ItemsSource="{Binding CardTypeFilters}"
                                  SelectedIndex="{Binding SelectedTypeIndex}"
                                  Width="160"
                                  Style="{StaticResource ModernComboBox}"
                                  Margin="0,0,10,0"/>
                        <Button Content="Найти"
                                Command="{Binding LoadCardsCommand}"
                                Style="{StaticResource PrimaryActionButton}"/>
                    </StackPanel>
                </Border>

                <!-- Список карт -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding AvailableCards}"
                                  ItemTemplate="{StaticResource AvailableCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Выбранная колода -->
            <Border Grid.Column="1" Grid.Row="1" Background="#0F0F1A" CornerRadius="12"
                    BorderBrush="#1A1A2E" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ВАША КОЛОДА"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#4A4A6A"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"
                               FontFamily="Consolas"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding DeckCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#080810" CornerRadius="8" Padding="8,6" Margin="0,4" BorderBrush="#1A1A2E" BorderThickness="1" MinHeight="58">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Background="#12121F" CornerRadius="5" Height="44" Width="44" VerticalAlignment="Center">
                                                <Image Source="{Binding Card.ImagePath, Converter={StaticResource ImagePathConverter}}"
                                                       Height="40"
                                                       Width="40"
                                                       Stretch="Uniform"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center">
                                                    <Image.Clip>
                                                        <RectangleGeometry Rect="0,0,40,40" RadiusX="4" RadiusY="4"/>
                                                    </Image.Clip>
                                                </Image>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Card.Name}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="#E0E0FF"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           MaxWidth="140"/>
                                                <TextBlock Text="{Binding Card.CardType, Converter={StaticResource CardTypeToDisplayConverter}}"
                                                           FontSize="13"
                                                           Foreground="{Binding Card.CardType, Converter={StaticResource CardTypeToColorConverter}}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="#1A1A2E" CornerRadius="6" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center" Height="22">
                                                <TextBlock FontSize="15" Foreground="#E0E0FF" FontWeight="Bold" VerticalAlignment="Center">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0}x">
                                                            <Binding Path="Quantity"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>

                                            <Button Grid.Column="3"
                                                    Content="✕"
                                                    Command="{Binding DataContext.RemoveCardFromDeckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="28"
                                                    Height="28"
                                                    Style="{StaticResource DangerActionButton}"
                                                    FontSize="16"
                                                    FontWeight="Bold"
                                                    Padding="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Удалить карту из колоды"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <Button Content="{Binding SaveButtonText}"
                                Command="{Binding SaveDeckCommand}"
                                IsEnabled="{Binding IsValid}"
                                Style="{StaticResource PrimaryActionButton}"
                                FontSize="18"
                                Padding="14,12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Кнопки управления -->
            <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Horizontal" Margin="0,14,12,0">
                <Button Content="Назад в меню"
                        Command="{Binding BackToMenuCommand}"
                        Style="{StaticResource SecondaryActionButton}"/>
                <Button Content="Очистить колоду"
                        Command="{Binding ClearDeckCommand}"
                        Style="{StaticResource DangerActionButton}"
                        Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Диалог сохранения колоды -->
        <Border Background="#00000080"
                Visibility="{Binding IsSaveDialogVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Border Background="#0F0F1A"
                        CornerRadius="16"
                        Padding="32"
                        BorderBrush="#1A1A2E"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="380">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="6" Opacity="0.5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#4A4A6A"
                                   FontFamily="Consolas"
                                   Margin="0,0,0,16"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="СОХРАНИТЬ КОЛОДУ"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Text" Value="ИЗМЕНИТЬ КОЛОДУ"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Введите название колоды"
                                   FontSize="18"
                                   Foreground="#8A8AA0"
                                   Margin="0,0,0,12"
                                   HorizontalAlignment="Center"/>
                        <TextBox Text="{Binding DeckName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,20"
                                 FontSize="20"
                                 Padding="14,12"
                                 HorizontalAlignment="Stretch"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Сохранить"
                                    Command="{Binding ConfirmSaveDeckCommand}"
                                    Style="{StaticResource PrimaryActionButton}"
                                    Width="130"
                                    Margin="0,0,10,0"/>
                            <Button Content="Отмена"
                                    Command="{Binding CancelSaveDialogCommand}"
                                    Style="{StaticResource SecondaryActionButton}"
                                    Width="130"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>